{
  "name": "bookshop",
  "version": "1.0.0",
  "description": "CAP Bookshop Application",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@sap/cds": "^10",
    "@cap-js/hana": "^3",
    "@cap-js/sqlite": "^3.1.1",
    "@sap/xsenv": "^6.2.2",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.1.1",
    "@sap/hdi-deploy": "^5.7.0",
    "@sap/approuter": "^16",
    "@sap/html5-app-deployer": "^4"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production",
    "deploy": "cds deploy --to hana",
    "undeploy": "cds undeploy --from hana",
    "watch-fiori": "cds watch --open browse/webapp/index.html?sap-ui-xx-viewCache=false"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sql"
      },
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "xsuaa"
        }
      }
    },
    "fiori": {
      "preview": true
    },
    "build": {
      "tasks": [
        {
          "for": "hana",
          "src": "db",
          "options": {
            "model": [
              "db",
              "srv"
            ]
          }
        },
        {
          "for": "node-cf",
          "src": "srv"
        },
        {
          "for": "fiori",
          "src": "app",
          "options": {
            "build": true
          }
        }
      ]
    }
  },
  "sapux": [
    "app/browse",
    "app/admin",
    "app/orders"
  ],
  "engines": {
    "node": "^20 || ^22 || ^24"
  }
}
